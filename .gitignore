#!/usr/bin/env python3
"""
Asynchronous TCP Port Scanner in Python
"""

import asyncio
import socket
import argparse
from typing import List, Tuple

# Common service port names for quick identification
COMMON_PORTS = {
    21: "FTP",
    22: "SSH",
    23: "Telnet",
    25: "SMTP",
    53: "DNS",
    80: "HTTP",
    110: "POP3",
    143: "IMAP",
    443: "HTTPS",
    465: "SMTPS",
    587: "Submission",
    993: "IMAPS",
    995: "POP3S",
    3306: "MySQL",
    3389: "RDP",
    5432: "PostgreSQL",
    6379: "Redis",
    8080: "HTTP-Proxy",
    27017: "MongoDB",
}


async def scan_port(
    host: str, port: int, timeout: float, semaphore: asyncio.Semaphore
) -> Tuple[int, bool, str]:
    """Attempts to establish a TCP connection to a given host and port."""
    async with semaphore:
        try:
            conn = asyncio.open_connection(host, port)
            _, writer = await asyncio.wait_for(conn, timeout=timeout)
            writer.close()
            await writer.wait_closed()
            service = COMMON_PORTS.get(port, "Unknown")
            return port, True, service
        except (asyncio.TimeoutError, OSError):
            return port, False, ""


async def run_scanner(
    target: str, start_port: int, end_port: int, timeout: float, concurrency: int
) -> None:
    """Orchestrates asynchronous port scanning over a range."""
    try:
        ip = socket.gethostbyname(target)
    except socket.gaierror:
        print(f"[!] Error: Unable to resolve hostname '{target}'.")
        return

    print(f"\n[+] Starting scan on target: {target} ({ip})")
    print(f"[+] Scanning ports {start_port} to {end_port}...")
    print(f"[+] Concurrency limit: {concurrency} | Timeout: {timeout}s\n")
    print(f"{'PORT':<10} {'STATUS':<10} {'SERVICE':<15}")
    print("-" * 35)

    semaphore = asyncio.Semaphore(concurrency)
    tasks: List[asyncio.Task] = [
        asyncio.create_task(scan_port(ip, port, timeout, semaphore))
        for port in range(start_port, end_port + 1)
    ]

    open_ports_count = 0
    for task in asyncio.as_completed(tasks):
        port, is_open, service = await task
        if is_open:
            open_ports_count += 1
            print(f"{port:<10} {'OPEN':<10} {service:<15}")

    print("-" * 35)
    print(f"[+] Scan completed. Found {open_ports_count} open port(s).\n")


def parse_ports(port_arg: str) -> Tuple[int, int]:
    """Parses port range string like '1-1024' or single port '80'."""
    if "-" in port_arg:
        start, end = map(int, port_arg.split("-"))
    else:
        start = end = int(port_arg)

    if not (1 <= start <= 65535 and 1 <= end <= 65535 and start <= end):
        raise ValueError("Invalid port specification. Ports must be between 1 and 65535.")
    return start, end


def main():
    parser = argparse.ArgumentParser(
        description="Fast Asynchronous TCP Port Scanner in Python"
    )
    parser.add_argument("target", help="Target IP address or hostname")
    parser.add_argument(
        "-p",
        "--ports",
        default="1-1024",
        help="Port range to scan (e.g., 80, 1-1024, 1-65535). Default: 1-1024",
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=float,
        default=1.0,
        help="Timeout in seconds for each connection (default: 1.0)",
    )
    parser.add_argument(
        "-c",
        "--concurrency",
        type=int,
        default=500,
        help="Maximum concurrent connection attempts (default: 500)",
    )

    args = parser.parse_args()

    try:
        start_port, end_port = parse_ports(args.ports)
    except ValueError as err:
        print(f"[!] {err}")
        return

    asyncio.run(
        run_scanner(
            target=args.target,
            start_port=start_port,
            end_port=end_port,
            timeout=args.timeout,
            concurrency=args.concurrency,
        )
    )


if __name__ == "__main__":
    main()
